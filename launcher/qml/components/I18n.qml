pragma Singleton

import QtQuick

// Live UI translation. English is the default; Korean is selectable in
// Settings. Every screen calls t()/f(), and because t() reads `lang`, each
// binding re-evaluates the moment the language changes - no restart needed.
QtObject {
    id: root

    property string lang: "en"

    function setLanguage(value) {
        root.lang = value === "ko" ? "ko" : "en"
    }

    function t(key) {
        const table = root.lang === "ko" ? root.ko : root.en
        if (table[key] !== undefined)
            return table[key]
        return root.en[key] !== undefined ? root.en[key] : key
    }

    function f(key, first, second) {
        let text = root.t(key)
        if (first !== undefined)
            text = text.replace("%1", first)
        if (second !== undefined)
            text = text.replace("%2", second)
        return text
    }

    function apps(count) {
        if (root.lang === "ko")
            return count + "\uAC1C \uC571"
        return count === 1 ? "1 app" : count + " apps"
    }

    function repositories(count) {
        if (root.lang === "ko")
            return count + "\uAC1C \uC800\uC7A5\uC18C"
        return count === 1 ? "1 repository" : count + " repositories"
    }

