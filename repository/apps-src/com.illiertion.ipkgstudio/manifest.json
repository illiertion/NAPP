{
  "format": "IPKG",
  "format_version": 1,
  "app": {
    "id": "com.illiertion.ipkgstudio",
    "name": "IPKG Studio",
    "version": "1.3.0",
    "description": "Build .ipkg packages with your own icon, window title/size/tray settings, a chosen save folder, live readiness checklist and the SDK/API reference downloaded from the store.",
    "author": "ILLIERTION",
    "license": "MIT"
  },
  "runtime": {
    "type": "chromium",
    "minimum_version": "1.3.0"
  },
  "sdk": {
    "minimum_version": "1.0.0"
  },
  "entry": "app/index.html",
  "platforms": [
    "windows-x64",
    "linux-x64"
  ],
  "permissions": [
    "storage",
    "clipboard",
    "external-links",
    "notifications"
  ],
  "metadata": {
    "icon": "metadata/icon.png",
    "preview": "metadata/preview.png"
  }
}
