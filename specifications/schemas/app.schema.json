{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.illiertion.com/napp/1/app.schema.json",
  "title": "NAPP app.json (저장소 개별 앱 매니페스트)",
  "description": "저장소가 제공하는 개별 앱 JSON의 schema_version 1 스키마. 버전별 IPKG 다운로드 정보를 담는다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "app", "compatibility", "release"],
  "$defs": {
    "app_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*){1,}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "platform": {
      "type": "string",
      "enum": [
        "windows-x64",
        "windows-arm64",
        "linux-x64",
        "linux-arm64",
        "macos-x64",
        "macos-arm64"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "소문자 16진수 64자"
    }
  },
  "properties": {
    "format": {
      "const": "NAPP-APP"
    },
    "schema_version": {
      "const": 1
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "author", "category", "icon"],
      "properties": {
        "id": {
          "$ref": "#/$defs/app_id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "maxLength": 40
        },
        "icon": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://"
        },
        "homepage": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://"
        },
        "license": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "platforms"],
      "properties": {
        "runtime": {
          "const": "chromium"
        },
        "minimum_runtime_version": {
          "$ref": "#/$defs/semver"
        },
        "minimum_sdk_version": {
          "$ref": "#/$defs/semver"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/platform"
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latest", "versions"],
      "properties": {
        "latest": {
          "$ref": "#/$defs/semver"
        },
        "versions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["release_date", "changelog", "package"],
            "properties": {
              "release_date": {
                "type": "string",
                "format": "date"
              },
              "changelog": {
                "type": "string",
                "maxLength": 8000
              },
              "deprecated": {
                "type": "boolean",
                "default": false,
                "description": "true이면 새 설치에 표시하되 기본 선택하지 않는다."
              },
              "yanked": {
                "type": "boolean",
                "default": false,
                "description": "true이면 신규 설치를 차단하고 업데이트 후보에서 제외한다."
              },
              "platforms": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/platform"
                },
                "description": "생략 시 compatibility.platforms를 따른다."
              },
              "package": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "url", "sha256", "size"],
                "properties": {
                  "type": {
                    "const": "web"
                  },
                  "url": {
                    "type": "string",
                    "maxLength": 2048,
                    "pattern": "^https://"
                  },
                  "sha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 536870912,
                    "description": "패키지 바이트 크기. 상한 512 MiB"
                  },
                  "signature": {
                    "type": "string",
                    "maxLength": 4096,
                    "description": "예약 필드. Ed25519 서명(도입 시 base64). format_version 1 런처는 값이 있으면 검증 실패로 처리하지 않고 표시만 한다."
                  }
                }
              }
            }
          }
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}
