{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.illiertion.com/napp/1/manifest.schema.json",
  "title": "IPKG manifest.json",
  "description": "NAPP IPKG format_version 1의 manifest.json 구조 스키마. JSON Schema 검증 통과는 필요조건이며, 경로 규칙·압축 해제 안전성 등 의미론적 검증은 IPKG_SPECIFICATION.md 6장을 따른다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "app",
    "runtime",
    "sdk",
    "entry",
    "platforms",
    "permissions",
    "metadata"
  ],
  "$defs": {
    "app_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*){1,}$",
      "description": "역DNS 형식의 소문자 앱 ID. 최소 2개 세그먼트, 예: com.illiertion.example"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
      "description": "Semantic Versioning 2.0.0"
    },
    "relative_path": {
      "type": "string",
      "minLength": 3,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*/\\.\\.?/)(?!^\\.\\.?(/|$))(?!.*/$).+$",
      "description": "패키지 루트 기준 상대 경로. 절대 경로, 드라이브 문자, 역슬래시, .. 및 . 세그먼트, 디렉터리로 끝나는 경로 금지"
    },
    "platform": {
      "type": "string",
      "enum": [
        "windows-x64",
        "windows-arm64",
        "linux-x64",
        "linux-arm64",
        "macos-x64",
        "macos-arm64"
      ],
      "description": "macos-* 값은 규격상 예약되어 있으며 format_version 1 런처는 지원 대상이 아니면 설치를 거부한다."
    },
    "permission": {
      "type": "string",
      "enum": [
        "storage",
        "window",
        "notifications",
        "dialog",
        "filesystem",
        "clipboard",
        "external-links",
        "system-info"
      ]
    }
  },
  "properties": {
    "format": {
      "const": "IPKG"
    },
    "format_version": {
      "const": 1
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "description", "author", "license"],
      "properties": {
        "id": {
          "$ref": "#/$defs/app_id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "SPDX 식별자 또는 라이선스 이름, 예: MIT"
        },
        "homepage": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://"
        },
        "keywords": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "minimum_version"],
      "properties": {
        "type": {
          "const": "chromium"
        },
        "minimum_version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_version"],
      "properties": {
        "minimum_version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "entry": {
      "allOf": [
        {
          "$ref": "#/$defs/relative_path"
        },
        {
          "pattern": "^app/",
          "description": "시작 페이지는 반드시 app/ 디렉터리 안에 있어야 한다"
        }
      ]
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/platform"
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/permission"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["icon", "preview"],
      "properties": {
        "icon": {
          "$ref": "#/$defs/relative_path"
        },
        "preview": {
          "$ref": "#/$defs/relative_path"
        },
        "screenshots": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relative_path"
          }
        }
      }
    },
    "window": {
      "type": "object",
      "description": "선택 사항. 앱 창의 제목/시작 크기와 트레이 아이콘 사용 여부. 사용하려면 permissions 에 \"window\" 가 있어야 한다.",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "창 제목. 없으면 app.name 을 쓴다."
        },
        "width": {
          "type": "integer",
          "minimum": 480,
          "maximum": 3840,
          "description": "시작 창 너비(논리 픽셀). 화면 작업 영역보다 크면 그 영역에 맞춰 줄인다."
        },
        "height": {
          "type": "integer",
          "minimum": 360,
          "maximum": 2160,
          "description": "시작 창 높이(논리 픽셀). 화면 작업 영역보다 크면 그 영역에 맞춰 줄인다."
        },
        "tray": {
          "type": "boolean",
          "description": "true 면 창을 닫아도 트레이에 남는다. 트레이 메뉴의 종료로 끝낸다."
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "향후 확장용 예약 필드. format_version 1 런처는 존재하지 않는 키를 무시하고 저장한다."
    }
  }
}
