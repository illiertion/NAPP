# Build output
build/
out/
# Distribution staging — both are regenerated by scripts/make-dist.ps1 and
# scripts/make-release.ps1 from the sources that are tracked here.
dist/
release/
CMakeUserPresets.json

# Native app packaging output (scripts/pack-app.ps1 / pack-app.py)
dist-apps/

# Third-party runtime distribution (fetched by scripts/fetch-cef.sh, not committed)
third_party/cef/

# IDE
.vs/
.vscode/
*.user
CMakeSettings.json

# Local test artifacts
tests/fixtures/*.ipkg
examples/*.ipkg
__pycache__/
*.pyc
