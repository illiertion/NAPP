// Windows version resource for a NAPP executable.
//
// cmake/NappCommon.cmake configures this into the build tree with
// napp_add_version_resource(), so the File Properties dialog always matches the
// project version in CMakeLists.txt instead of drifting by hand.
//
// cmake/NappCommon.cmake 의 napp_add_version_resource() 가 이것을 빌드 트리에
// 구성해 넣는다. 속성 창의 버전이 CMakeLists.txt 의 버전과 항상 같도록 하기 위함이다.

#include <winver.h>

IDI_ICON1 ICON DISCARDABLE "@NAPP_RC_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @NAPP_RC_FILEVERSION@
 PRODUCTVERSION @NAPP_RC_FILEVERSION@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @NAPP_RC_FILETYPE@
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "@NAPP_RC_COMPANY@"
            VALUE "FileDescription",  "@NAPP_RC_DESCRIPTION@"
            VALUE "FileVersion",      "@NAPP_RC_VERSION@"
            VALUE "InternalName",     "@NAPP_RC_INTERNAL_NAME@"
            VALUE "LegalCopyright",   "@NAPP_RC_COPYRIGHT@"
            VALUE "OriginalFilename", "@NAPP_RC_ORIGINAL_FILENAME@"
            VALUE "ProductName",      "@NAPP_RC_PRODUCT@"
            VALUE "ProductVersion",   "@NAPP_RC_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END